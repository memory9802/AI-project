DROP TABLE IF EXISTS rating;  INDEX idx_item_id (item_id),

CREATE TABLE rating (  INDEX idx_rating_value (rating_value),

  id INT AUTO_INCREMENT PRIMARY KEY,  INDEX idx_created_at (created_at),

  user_id INT NOT NULL COMMENT '評分的使用者ID',  

  item_source ENUM('items', 'user_wardrobe') NOT NULL DEFAULT 'items' COMMENT '評分來源: items=商品庫, user_wardrobe=使用者衣櫃',  UNIQUE KEY unique_user_item (user_id, item_id) COMMENT '同一使用者對同一商品只能評分一次'

  item_id INT NOT NULL COMMENT '被評分的商品ID (泛用,根據 item_source 指向 items.id 或 user_wardrobe.id)',) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci

  rating_value INT NOT NULL COMMENT '評分值 (建議 1-5 星)',COMMENT='商品評分表 - 記錄使用者對商品的評分和評論';

  review_text TEXT DEFAULT NULL COMMENT '評論內容',

