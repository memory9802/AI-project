# =====================================
# MySQL 自訂建置 Dockerfile
# 確保每次都使用最新的初始化腳本
# =====================================

FROM mysql:8.0

# 設定作者資訊
LABEL maintainer="AI-project Team"
LABEL description="Custom MySQL with pre-built init scripts"
LABEL version="2.0-optimized"

# 將初始化 SQL 腳本直接複製到映像中
# ⚠️ 重要: 只複製 .sql 檔案,排除其他檔案
COPY ./init/*.sql /docker-entrypoint-initdb.d/

# 設定正確的檔案權限
# MySQL init 目錄和檔案權限必須正確,否則無法執行
RUN chmod 755 /docker-entrypoint-initdb.d && \
    chmod 644 /docker-entrypoint-initdb.d/*.sql

# 驗證權限和檔案內容
RUN echo "=== MySQL Init Files ===" && \
    ls -lh /docker-entrypoint-initdb.d/ && \
    echo "=== Total SQL files: $(ls /docker-entrypoint-initdb.d/*.sql 2>/dev/null | wc -l) ===" && \
    echo "=== Build timestamp: $(date) ===" && \
    echo "=== Setup completed ==="

# 使用官方 MySQL 的預設配置
# 支援 utf8mb4 和現代認證外掛
CMD ["mysqld"]